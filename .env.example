# Required for guest validation and server-side Firebase access
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_SECRET=replace-with-server-only-database-credential

# Required for guest request, taxi, cafe, and login notifications
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Optional: separate Telegram destinations
# TELEGRAM_REQUEST_CHAT_IDS=
# TELEGRAM_SESSION_CHAT_IDS=
# Required for Telegram inline status buttons
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_STATUS_USER_IDS=123456789

# Optional: web push support
# FIREBASE_SERVICE_ACCOUNT_JSON=
# PUSH_API_SECRET=
# CRON_SECRET=
